# Limite de tentativas de login por IP (generoso: varias pessoas podem sair pelo mesmo IP do escritorio)
limit_req_zone $binary_remote_addr zone=operacoes_login:10m rate=10r/m;

server {
    listen 80;
    server_name operacoes.solarsync.com.br;

    location = /auth/login {
        limit_req zone=operacoes_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
