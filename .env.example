DB_USER=operacoes
DB_PASSWORD=troque_esta_senha
DB_NAME=operacoes_db
DATABASE_URL=postgresql://operacoes:troque_esta_senha@db:5432/operacoes_db

# Chave secreta usada para assinar os tokens de login (JWT).
# Gere uma nova e diferente da de producao com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque_esta_chave_tambem

# Configuracao de e-mail para o alerta automatico de ASOs vencendo.
# Se voce usar Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, e em
# SMTP_PASSWORD use uma "senha de app" (nao a senha normal da conta) -
# gere em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=troque_pelo_email_que_vai_enviar@gmail.com
SMTP_PASSWORD=troque_pela_senha_de_app
SMTP_FROM=troque_pelo_email_que_vai_enviar@gmail.com

# Quem recebe o alerta de ASOs vencendo (separe por virgula se for mais de um)
ALERTA_ASO_EMAILS=sidneimsf@gmail.com

# Quem recebe o e-mail diario de custos pendentes de reembolso (separe por virgula)
REEMBOLSO_EMAILS=sidneimsf@gmail.com

# Quem recebe o alerta de colaboradores em fim de periodo de experiencia (30/90 dias)
ALERTA_EXPERIENCIA_EMAILS=sidneimsf@gmail.com
